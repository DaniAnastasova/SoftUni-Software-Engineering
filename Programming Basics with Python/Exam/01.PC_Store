price_processor_in_dollar = float(input())
price_video_card_in_dollar = float(input())
price_RAM_in_dollar = float(input())
count_RAM = int(input())
discount_percent = float(input())
all_sum = 0
price_processor_in_BNG = 0
price_video_card_in_BNG = 0
all_sum_for_RAM = 0

price_processor_in_BNG = 1.57 * price_processor_in_dollar
price_video_card_in_BNG = 1.57 * price_video_card_in_dollar
price_RAM_in_BNG = 1.57 * price_RAM_in_dollar
all_sum_for_RAM = price_RAM_in_BNG * count_RAM

price_processor_in_BNG = price_processor_in_BNG -(discount_percent  * price_processor_in_BNG)
price_video_card_in_BNG = price_video_card_in_BNG - (discount_percent  * price_video_card_in_BNG)

all_sum = price_processor_in_BNG + price_video_card_in_BNG +all_sum_for_RAM

print(f"Money needed - {(all_sum):.2f} leva.")
